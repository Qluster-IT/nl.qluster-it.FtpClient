    "title": {
      "en": "Get file URL",
      "nl": "Ontvang bestand url"
    },
    "titleFormatted": {
      "en": "Get an Image Token for [[image]] / [[path]]",
      "nl": "Ontvang een Afbeelding Token voor [[image]] / [[path]]"
