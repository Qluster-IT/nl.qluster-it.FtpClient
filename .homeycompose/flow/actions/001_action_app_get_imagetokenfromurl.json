{
    "id": "action_app_get_imagetokenfromurl",
    "title": {
      "en": "Get an Image Token from URL",
      "nl": "Ontvang een afbeeldingstoken van Url"
    },
    "titleFormatted": {
      "en": "Get an Image Token for [[url]], available for [[availableduration]] seconds",
      "nl": "Ontvang een Afbeelding Token voor [[url]], beschikbaar voor [[availableduration]] seconden"
    },
    "args": [ 
    {
      "name": "url",
      "type": "text",
      "placeholder":{
        "en":"URL (* BLL supported)",
        "nl":"Url (* BLL ondersteund)"
      },
      "title":{
        "en":"URL",
        "nl":"Url"
      }
    },
    {
      "name": "availableduration",
      "type": "number",
      "placeholder": {
        "en":"0 = untill app restart",
        "nl":"0 = tot app herstart"
      },
      "title":{
        "en":"Number of",
        "nl":"Aantal"
      },
      "min":0,
      "value":60
    }
    ],
    "tokens":[
      {
        "name":"image",
        "type":"image",
        "title":{
          "en":"Image",
          "nl":"Afbeelding"
        }
      }
    ]
  }