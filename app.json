{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.qluster-it.FtpClient",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Ftp Client"
  },
  "description": {
    "en": "Ftp Client(s)"
  },
  "brandColor": "#2B738C",
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "contributors": {
    "translators": [
      {
        "name": "Ronny Winkler (imagery)"
      }
    ]
  },
  "api": {
    "uploadFiles": {
      "method": "POST",
      "path": "/uploadFiles",
      "public": true
    }
  },
  "flow": {
    "actions": [
      {
        "id": "action_ftpclient_get_url",
        "title": {
          "en": "Get file URL",
          "nl": "Ontvang bestand url"
        },
        "titleFormatted": {
          "en": "Get URL for [[file]]",
          "nl": "Ontvang Url voor [[file]]"
        },
        "hint": "URL",
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=ftpclient"
          },
          {
            "name": "file",
            "type": "autocomplete",
            "placeholder": "File"
          }
        ],
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "URL",
              "nl": "Url"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "ftpclient",
      "name": {
        "en": "Ftp Client"
      },
      "images": {
        "large": "drivers/ftpclient/assets/images/large.png",
        "small": "drivers/ftpclient/assets/images/small.png"
      },
      "class": "other",
      "capabilities": [],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "login_credentials"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "logo": "logo.png",
            "usernameLabel": {
              "en": "Username"
            },
            "usernamePlaceholder": {
              "en": "anonymous"
            },
            "passwordLabel": {
              "en": "Password"
            },
            "passwordPlaceholder": {
              "en": ""
            }
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "ftpclient"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP or hostname"
          },
          "value": "192.168.1.17"
        },
        {
          "id": "port",
          "type": "number",
          "label": {
            "en": "Port"
          },
          "value": 5081
        },
        {
          "id": "username",
          "type": "text",
          "label": {
            "en": "Username"
          },
          "value": "anonymous",
          "hint": "anonymous"
        },
        {
          "id": "password",
          "type": "password",
          "label": {
            "en": "Password"
          },
          "value": ""
        },
        {
          "id": "secure",
          "type": "checkbox",
          "label": {
            "en": "Secure"
          },
          "value": false
        },
        {
          "id": "downloadtime",
          "type": "number",
          "label": {
            "en": "Download Time (Seconds)"
          },
          "value": 60
        }
      ]
    }
  ],
  "discovery": {
    "ftp_mDNS-SD": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_ftp",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}"
    }
  }
}